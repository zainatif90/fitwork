# Copy this file to .env and fill in the values. Never commit .env.

# --- General ---
ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Database / cache (matches docker-compose.yml) ---
POSTGRES_USER=fitwork
POSTGRES_PASSWORD=fitwork_dev_pw
POSTGRES_DB=fitwork
DATABASE_URL=postgresql+psycopg://fitwork:fitwork_dev_pw@localhost:5433/fitwork
TEST_DATABASE_URL=postgresql+psycopg://fitwork:fitwork_dev_pw@localhost:5433/fitwork_test
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate one with:  py -3.11 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Job ingestion ---
# Optional: public Freelancer.com endpoints work without a token
FREELANCER_API_TOKEN=
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MIN=30

# --- LLM for proposals (gemini | openai) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_THINKING_LEVEL=minimal

# --- Production settings (Render + Firebase). Safe example values; real ones live only on Render. ---
# Website on another domain than the API: cross-site refresh cookie
# COOKIE_SAMESITE=none
# COOKIE_PARTITIONED=true
# ENABLE_API_DOCS=false                 # true only while demonstrating /api/docs
# KEEPALIVE_URL=https://your-api.onrender.com/api/health   # self-ping so the free server never sleeps
# CRON_SECRET=change-me                 # protects /api/internal/ingest
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/.../exec   # Apps Script mailer (SMTP is blocked on Render free)
# EMAIL_WEBHOOK_SECRET=change-me
# BOOTSTRAP_DATA=true                   # first start: load the seed jobs if the database is empty
# JOB_BOARDS_ENABLED=true               # Himalayas / Remotive / Jobicy fetches

# --- Rate limits (defaults shown) ---
# LOGIN_RATE_LIMIT_PER_MIN=5            # failed logins per minute per IP + email
# LOGIN_FAILS_PER_EMAIL=10              # failed logins per email per 15 minutes (any IP)
# REGISTER_PER_IP_HOUR=10
# RESET_REQUESTS_PER_HOUR=3             # reset emails per address per hour
# RESET_REQUESTS_PER_IP_HOUR=20
